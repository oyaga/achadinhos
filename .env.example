# ===== Postgres =====
POSTGRES_USER=achadinhos
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=achadinhos

# ===== App =====
# Host port to expose the app on. Behind a reverse proxy you usually keep 8080.
APP_PORT=8080
APP_LOG_LEVEL=info

# JWT signing secret — MUST be a long random string in production.
# Generate one with: openssl rand -hex 48
JWT_SECRET=change-me-please-use-openssl-rand-hex-48

# Comma-separated list of allowed CORS origins. Leave empty when frontend is
# served same-origin (which is our case after unification).
CORS_ORIGINS=

# Build-time: where the frontend points to for the API. Same-origin uses the
# relative path. If you split front/back later, set the absolute URL here.
NEXT_PUBLIC_API_URL=/api/v1

# ===== Postgres =====
POSTGRES_USER=achadinhos
# Gere com: openssl rand -hex 24  (a app recusa subir em produção com valor "change-me")
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=achadinhos

# ===== App =====
# Host port to expose the app on. Behind a reverse proxy you usually keep 8080.
APP_PORT=8080
APP_LOG_LEVEL=info

# JWT signing secret — MUST be a long random string in production.
# Generate one with: openssl rand -hex 48
JWT_SECRET=change-me-please-use-openssl-rand-hex-48

# Comma-separated list of allowed CORS origins. Leave empty when frontend is
# served same-origin (which is our case after unification).
CORS_ORIGINS=

# Build-time: where the frontend points to for the API. Same-origin uses the
# relative path. If you split front/back later, set the absolute URL here.
NEXT_PUBLIC_API_URL=/api/v1

# Anti-bot/anti-clonagem: token que permite pular o bloqueio de user-agent e o
# rate limit via header "X-Antibot-Bypass" (para inspeção headless própria).
# Generate one with: openssl rand -hex 32. Vazio = sem bypass.
ANTIBOT_BYPASS_TOKEN=

# Proxies confiáveis para resolver o IP real do cliente (rate limit/logs).
# Padrão: redes privadas do Docker (Traefik). NUNCA coloque 0.0.0.0/0.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# E-mail (Resend) e agenda (Google OAuth) — opcionais; vazio desliga o recurso.
RESEND_API_KEY=
MAIL_FROM=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

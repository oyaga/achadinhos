APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=debug
# URL pública do frontend — usada para montar links enviados por e-mail
# (ex.: o link da ficha de cadastro). Sem barra no final.
APP_BASE_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=achadinhos
DB_PASSWORD=achadinhos_dev
DB_NAME=achadinhos
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production-this-is-not-secure
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# E-mail transacional (Resend). Deixe vazio para desligar o envio (boas-vindas
# e ficha de cadastro viram no-op). Para enviar para qualquer destinatário, o
# domínio em MAIL_FROM precisa estar verificado no painel do Resend.
RESEND_API_KEY=
MAIL_FROM=noreply@achadinhoscondominio.com.br

# Google OAuth (feature de agendamento — Google Calendar + Meet). Crie as
# credenciais em https://console.cloud.google.com/apis/credentials com o
# redirect URI: {APP_BASE_URL}/api/v1/agenda/google/callback
# Deixe vazio para desligar (endpoints respondem "google_not_configured").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Anti-bot/anti-clonagem (ativo so com APP_ENV=production). Requisicoes com o
# header "X-Antibot-Bypass: <token>" pulam o bloqueio de user-agent e o rate
# limit — use no seu proprio headless/CDP contra a producao. Gere um valor
# aleatorio longo (ex.: openssl rand -hex 32). Vazio = sem bypass.
ANTIBOT_BYPASS_TOKEN=

